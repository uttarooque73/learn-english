# SQLite persistence. Defaults to ./data/speakup.sqlite.
# For Docker or a host with persistent storage, set this to a writable persistent path.
SQLITE_DATABASE_PATH=./data/speakup.sqlite

# Server-side Ollama configuration (never expose these as NEXT_PUBLIC_* variables).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Optional local phoneme-level pronunciation service (OpenPronounce companion).
PRONUNCIATION_SERVICE_URL=http://127.0.0.1:8001

# Durable learning scheduler/worker. Generate a random secret with at least 32 characters.
# Set the same value in the app server environment and the worker host environment.
LEARNING_WORKER_SECRET=
LEARNING_WORKER_URL=http://127.0.0.1:3000/api/learning/worker
LEARNING_SCHEDULER_URL=http://127.0.0.1:3000/api/learning/scheduler
LEARNING_WORKER_INTERVAL_SECONDS=10
