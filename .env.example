# PostgreSQL persistence for app data (required for durable storage).
# Use a managed PostgreSQL provider and keep this server-side variable private.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Set to true only if your provider requires TLS without a verifiable CA chain.
DATABASE_SSL=false

# Server-side Ollama configuration (never expose these as NEXT_PUBLIC_* variables).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Optional local phoneme-level pronunciation service (OpenPronounce companion).
PRONUNCIATION_SERVICE_URL=http://127.0.0.1:8001
